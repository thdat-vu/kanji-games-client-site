# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# We use npm; reject yarn lockfile if accidentally generated.
yarn.lock

# Claude Code per-machine settings (allowlist) — never commit.
.claude/settings.local.json

# Raw datasets downloaded by scripts/seed-n5/download.ts (~30MB, regenerable)
/data/raw/
