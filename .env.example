# Supabase — required for auth + DB. Use the publishable key (sb_publishable_...)
# or fall back to the legacy anon JWT for the public client.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Footer links (server-only, not exposed to the client bundle).
# Both are optional — the link/icon disappears if the var is empty.
GITHUB_REPO_URL=https://github.com/<you>/<repo>
GITHUB_AUTHOR=https://github.com/<you>
