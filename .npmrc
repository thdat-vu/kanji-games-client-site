# Block postinstall scripts. Major attack surface (Shai-Hulud, npm worm).
# When a package legitimately needs scripts, vet then run:
#   npm rebuild <pkg> --foreground-scripts
ignore-scripts=true

# `npm install <pkg>` writes exact versions, not caret ranges.
save-exact=true

# Block install if any moderate+ vuln in the dep tree (lockfile is source of truth — `npm ci`).
audit-level=moderate

# No fund/donate ASCII spam in CI.
fund=false

# NOTE: a `minimum-release-age` config exists in some npm 11.x docs but is not honored
# by npm 11.12 (warns "Unknown project config"). For now we rely on `ignore-scripts` +
# `audit-level` + manual review of new deps. Re-add when officially supported.
